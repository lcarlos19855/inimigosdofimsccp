NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Opcional: necessária para incluir/excluir usuários pela aba Usuários e para o
# cadastro público (/cadastro-integrante). Server Actions only.
# Supabase → Project Settings → API → service_role (secret). Nunca use NEXT_PUBLIC_ nem commite no git.
# SUPABASE_SERVICE_ROLE_KEY=

# Código secreto da turma para o link público /cadastro-integrante
# (envie o mesmo código no WhatsApp junto com o link).
# CADASTRO_TURMA_CODIGO=sua-senha-da-turma

# Mailjet — comunicados (envio pelo app no Render)
MAILJET_API_KEY=sua-api-key
MAILJET_SECRET_KEY=sua-secret-key
MAIL_FROM_EMAIL=remetente@seudominio.com
MAIL_FROM_NAME=Inimigos do Fim

# Produção (Render): use as mesmas chaves no painel Environment do serviço.
# No Supabase → Authentication → URL Configuration:
#   Site URL = https://SEU-APP.onrender.com
#   Redirect URLs = https://SEU-APP.onrender.com/**

# Esqueci a senha — configure SMTP no SUPABASE (não no Render):
# Supabase → Project Settings → Authentication → SMTP Settings → Enable Custom SMTP
#   Host: in-v3.mailjet.com
#   Port: 587
#   Username: MAILJET_API_KEY (mesma API Key)
#   Password: MAILJET_SECRET_KEY (mesma Secret Key)
#   Sender email: mesmo MAIL_FROM_EMAIL (validado no Mailjet)
#   Sender name: Inimigos do Fim
